---
import { getCollection } from "astro:content";
import SiteFrame from "../layouts/SiteFrame.astro";
import PostStream from "../components/PostStream.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft && data.category === "experience"))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---

<SiteFrame title="经历" activePath="/experience/" center={false}>
  <section class="xx-section-head">
    <p class="maintenance-eyebrow">EXPERIENCE</p>
    <h1>经历</h1>
    <p>学习、研究和工作经历会整理在这里。</p>
  </section>

  {posts.length === 0 ? (
    <p class="xx-empty">经历内容正在整理，敬请期待。</p>
  ) : (
    <div class="xx-post-stream">
      <PostStream posts={posts} />
    </div>
  )}
</SiteFrame>

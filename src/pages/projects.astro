---
import { getCollection } from "astro:content";
import SiteFrame from "../layouts/SiteFrame.astro";
import PostStream from "../components/PostStream.astro";
import { projectGroups } from "../config/site";

const posts = await getCollection("posts", ({ data }) => !data.draft && data.category === "project");

const sortPosts = (list: typeof posts) =>
  list.sort((a, b) => {
    const pa = a.data.pinned ? 1 : 0;
    const pb = b.data.pinned ? 1 : 0;
    if (pa !== pb) return pb - pa;
    return (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);
  });

const groups = projectGroups
  .map((group) => ({
    ...group,
    posts: sortPosts(posts.filter((p) => (p.data.project ?? "other") === group.key)),
  }))
  .filter((group) => group.posts.length > 0);
---

<SiteFrame title="项目" activePath="/projects/" center={false}>
  <section class="xx-section-head">
    <p class="maintenance-eyebrow">PROJECTS</p>
    <h1>项目</h1>
    <p>项目案例、实践过程和技术复盘会整理在这里。</p>
  </section>

  {groups.length === 0 && (
    <p class="xx-empty">项目内容正在整理，敬请期待。</p>
  )}

  {groups.map((group) => (
    <section class="xx-group">
      <div class="xx-group-head">
        <h2>{group.label}</h2>
        <p>{group.description}</p>
      </div>
      <div class="xx-post-stream">
        <PostStream posts={group.posts} />
      </div>
    </section>
  ))}
</SiteFrame>

---
import "../styles/site.css";
import LineIcon from "../components/LineIcon.astro";
import { blogInfo, hotPosts, navigation } from "../config/site";

interface Props {
  title?: string;
  activePath?: string;
  showRightbar?: boolean;
  mainId?: string;
  center?: boolean;
  stats?: [string, string][];
}

const {
  title = "Fuhai Blog",
  activePath = Astro.url.pathname,
  showRightbar = false,
  mainId,
  center,
  stats = blogInfo,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Fuhai 的个人博客，记录项目、经历、视频和生活随记。" />
    <title>{title === "Fuhai Blog" ? title : `${title} · Fuhai Blog`}</title>
  </head>
  <body class="home-body xxhzm-theme">
    <div class="xx-app">
      <header class="xx-topbar">
        <a class="xx-brand" href="/" aria-label="Fuhai Blog 首页">
          <span class="xx-line-icon"><LineIcon name="home" /></span>
          <strong>Fuhai Blog</strong>
        </a>

        <a class="xx-time" href="/experience/" aria-label="查看经历">
          <span class="xx-line-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v6l4 2" /></svg>
          </span>
          <svg class="xx-caret" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5" /></svg>
        </a>

        <label class="xx-search">
          <span class="sr-only">搜索首页文章</span>
          <input id="site-search" type="search" placeholder="搜索（⌘ + K）" autocomplete="off" />
          <span class="xx-line-icon">
            <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
          </span>
        </label>

        <div class="xx-top-actions">
          <a class="xx-action has-badge" href="/comments/" aria-label="评论">
            <span>新</span>
            <svg viewBox="0 0 24 24"><path d="M4 5h16v12H9l-5 4z" /></svg>
          </a>
          <a class="xx-action" href="/admin/" aria-label="管理入口">
            <svg viewBox="0 0 24 24"><path d="M15 7a4 4 0 1 0-3 3.87L5 18v3h3l7.12-7.12A4 4 0 0 0 15 7z" /><path d="m17 9 3 3" /></svg>
          </a>
        </div>
      </header>

      <aside class="xx-sidebar">
        <section class="xx-profile">
          <img src="/images/profile.jpeg" alt="Fuhai Liang" />
          <h2>Fuhai <span></span></h2>
          <p>记 <em>S</em>-<em>0</em>#<em>1</em></p>
        </section>

        <nav class="xx-side-nav" aria-label="主导航">
          <small>导航</small>
          {navigation.map((item) => (
            <a href={item.href} class={activePath === item.href ? "active" : ""}>
              <span class={`xx-nav-icon ${item.icon}`}><LineIcon name={item.icon} /></span>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="xx-sidebar-bottom">
          <a href="/admin/">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" /></svg>
            管理
          </a>
          <a href="/">
            <svg viewBox="0 0 24 24"><path d="M4 19V5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2z" /><path d="M8 7h6M8 11h6" /></svg>
            文章
          </a>
          <a href="/comments/">
            <svg viewBox="0 0 24 24"><path d="M4 5h16v12H9l-5 4z" /></svg>
            评论
          </a>
        </div>
      </aside>

      <nav class="xx-mobile-nav" aria-label="移动端导航">
        {navigation.map((item) => (
          <a href={item.href} class={activePath === item.href ? "active" : ""}>
            <span class="xx-nav-icon"><LineIcon name={item.icon} /></span>
            {item.label}
          </a>
        ))}
      </nav>

      <div class:list={["xx-page", !showRightbar && "xx-page-wide"]}>
        <main class:list={["xx-main", !showRightbar && (center === false ? "xx-section-list" : "xx-section-main")]} id={mainId}>
          <slot />
        </main>

        {showRightbar && (
          <aside class="xx-rightbar">
            <div class="xx-tabs" aria-hidden="true">
              <span class="active"><svg viewBox="0 0 24 24"><path d="M7 11v9H4v-9zM7 11l5-8 1.5 1.5L12 10h7a2 2 0 0 1 2 2l-1 6a2 2 0 0 1-2 2H7" /></svg></span>
              <span><svg viewBox="0 0 24 24"><path d="M4 5h16v12H9l-5 4z" /></svg></span>
              <span><svg viewBox="0 0 24 24"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 21V7" /><path d="M12 7H7.5a2.5 2.5 0 1 1 2.15-3.78L12 7h4.5a2.5 2.5 0 1 0-2.15-3.78z" /></svg></span>
            </div>

            <section class="xx-widget">
              <h3>热门文章</h3>
              <div class="xx-hot-list">
                {hotPosts.map((post) => (
                  <a href={post.href} class={`hot-${post.hue}`}>
                    <span class="xx-hot-cover" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M5 18V7a5 5 0 0 1 10 0v11" /><path d="M5 18h14v3H5z" /><circle cx="15" cy="10" r="1.5" /></svg>
                    </span>
                    <strong>{post.title}</strong>
                    <small><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>{post.views}</small>
                  </a>
                ))}
              </div>
            </section>

            <section class="xx-widget xx-blog-info">
              <h3>博客信息</h3>
              {stats.map(([label, value], index) => (
                <p><span>{label}</span><b class={`tone-${index}`}>{value}</b></p>
              ))}
            </section>
          </aside>
        )}
      </div>
    </div>

    <script>
      const input = document.querySelector<HTMLInputElement>("#site-search");
      document.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          input?.focus();
        }
      });

      input?.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" || location.pathname === "/") return;
        const query = input.value.trim();
        if (query) location.href = `/?q=${encodeURIComponent(query)}`;
      });
    </script>
  </body>
</html>
